{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/players",
      "destination": "/players.html"
    },
    {
      "source": "/rankings",
      "destination": "/rankings.html"
    },
    {
      "source": "/medicals",
      "destination": "/medicals.html"
    },
    {
      "source": "/teams",
      "destination": "/teams.html"
    },
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/fantasy",
      "destination": "/fantasy.html"
    },
    {
      "source": "/draft",
      "destination": "/draft.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/compare",
      "destination": "/players",
      "permanent": true
    }
  ]
}
